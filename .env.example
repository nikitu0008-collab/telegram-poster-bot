# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал-назначение, например @my_channel
CHANNEL_ID=

# api_id и api_hash с https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Интервал сбора контента, минуты
POST_INTERVAL_MINUTES=60

# Интервал публикации, минуты
PUBLISH_INTERVAL_MINUTES=30

# Максимум постов за один сбор
MAX_POSTS_PER_COLLECT=20

# Вероятность добавить мем при сборе (0..1)
MEME_PROBABILITY=0.4

# Telegram-каналы-источники через запятую
SOURCE_CHANNELS=

# RSS/Atom-ленты через запятую
RSS_FEEDS=
